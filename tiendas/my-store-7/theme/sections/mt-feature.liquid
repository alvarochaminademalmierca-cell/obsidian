{{ 'mt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: clamp(28px, 4vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .mt-body { font-size: {{ section.settings.body_size }}px; }
{% endstyle %}
{%- assign p = section.settings.product -%}
<section class="mt-feature-section mt-section">
  <div class="mt-container mt-feature{% if section.settings.reverse %} mt-feature--reverse{% endif %}">
    <div class="mt-feature__media mt-reveal">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {%- elsif p != blank and p.images.size > 0 -%}
        {%- assign idx = section.settings.product_image_number | minus: 1 -%}
        {%- assign img = p.images[idx] | default: p.featured_image -%}
        <img src="{{ img | image_url: width: 1200 }}" alt="{{ p.title | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="mt-feature__text">
      {%- if section.settings.eyebrow != blank -%}<p class="mt-eyebrow mt-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="mt-h2 mt-reveal" data-delay="1">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<div class="mt-body mt-reveal" data-delay="2" style="margin-top:14px">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
      {%- assign points = section.settings.points | newline_to_br | split: '<br />' -%}
      {%- if section.settings.points != blank -%}
      <ul class="mt-feature__points mt-reveal" data-delay="2">
        {%- for pt in points -%}{%- assign t = pt | strip -%}{%- if t != blank -%}<li><span class="mt-check">{% render 'mt-icon', name: 'check' %}</span><span>{{ t }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
      {%- endif -%}
      {%- if section.settings.btn_text != blank -%}
        <a class="mt-btn mt-reveal" data-delay="3" href="{% if section.settings.btn_link != blank %}{{ section.settings.btn_link }}{% elsif p != blank %}{{ p.url }}{% else %}#{% endif %}">{{ section.settings.btn_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MT – Image with text",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (image + button link)" },
    { "type": "range", "id": "product_image_number", "label": "Which product photo to show", "min": 1, "max": 20, "step": 1, "default": 1 },
    { "type": "image_picker", "id": "image", "label": "Custom image (overrides product photo)" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small text above title", "default": "Why you'll love it" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Designed for happy pets" },
    { "type": "textarea", "id": "body", "label": "Text" },
    { "type": "textarea", "id": "points", "label": "Bullet points (one per line)" },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "btn_link", "label": "Button link (empty = product page)" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Title size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "body_size", "label": "Text size", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 17 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "MT – Image with text" } ]
}
{% endschema %}
