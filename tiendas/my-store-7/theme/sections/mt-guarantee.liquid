{{ 'mt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: clamp(24px, 3.4vw, {{ section.settings.heading_size }}px); }
{% endstyle %}
<section class="mt-guarantee-section mt-section">
  <div class="mt-container">
    <div class="mt-guarantee mt-reveal">
      <div class="mt-guarantee__seal"><span><b>{{ section.settings.seal_number }}</b>{{ section.settings.seal_text }}</span></div>
      <div>
        <h2 class="mt-h2">{{ section.settings.heading }}</h2>
        <div class="mt-body" style="margin-top:12px">{{ section.settings.body | newline_to_br }}</div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MT – Guarantee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "seal_number", "label": "Seal number", "default": "30" },
    { "type": "text", "id": "seal_text", "label": "Seal text", "default": "Day guarantee" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Love it or your money back" },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Try it at home for 30 days. If your pet isn't loving it, contact us and we'll make it right with a full refund." },
    { "type": "range", "id": "heading_size", "label": "Title size", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 32 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "MT – Guarantee" } ]
}
{% endschema %}
