{{ 'mt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: clamp(26px, 4vw, {{ section.settings.heading_size }}px); }
{% endstyle %}
<section class="mt-faq-section mt-section">
  <div class="mt-container">
    <div class="mt-head mt-head--center mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="mt-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="mt-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="mt-faq mt-reveal">
      {%- for block in section.blocks -%}
        <details class="mt-faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="mt-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MT – FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above title", "default": "Questions?" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "range", "id": "heading_size", "label": "Title size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are processed within 1–2 business days and delivered with free tracked shipping.</p>" }
    ] }
  ],
  "presets": [ { "name": "MT – FAQ", "blocks": [ { "type": "question" } ] } ]
}
{% endschema %}
