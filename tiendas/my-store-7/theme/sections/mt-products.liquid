{{ 'mt-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: clamp(28px, 4vw, {{ section.settings.heading_size }}px); }
{% endstyle %}
<section class="mt-products mt-section" id="mt-products">
  <div class="mt-container">
    <div class="mt-head mt-head--{{ section.settings.text_align }} mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="mt-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="mt-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<div class="mt-body">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
    </div>
    <div class="mt-cards">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
        <a class="mt-card mt-reveal" data-delay="{{ forloop.index }}" href="{{ p.url }}" {{ block.shopify_attributes }}>
          <div class="mt-card__media">
            {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 900 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" loading="lazy" width="900" height="900">{%- endif -%}
            {%- if block.settings.tag != blank -%}<span class="mt-card__tag">{{ block.settings.tag }}</span>{%- endif -%}
          </div>
          <div class="mt-card__body">
            <h3 class="mt-card__title">{{ p.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="mt-card__text">{{ block.settings.text }}</p>{%- endif -%}
            <div class="mt-card__row">
              <span class="mt-card__price">{% if p.price_varies %}From {% endif %}{{ p.price_min | money }}</span>
              <span class="mt-card__link">{{ section.settings.link_text }} {% render 'mt-icon', name: 'arrow' %}</span>
            </div>
          </div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MT – Products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above title", "default": "The essentials" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Two smart products. One happy pet." },
    { "type": "textarea", "id": "body", "label": "Text" },
    { "type": "text", "id": "link_text", "label": "Card link text", "default": "Shop now" },
    { "type": "select", "id": "text_align", "label": "Title alignment", "options": [ {"value": "left", "label": "Left"}, {"value": "center", "label": "Center"} ], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Title size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom space", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40 }
  ],
  "blocks": [
    { "type": "product", "name": "Product card", "limit": 4, "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "tag", "label": "Label on image", "default": "Bestseller" },
      { "type": "text", "id": "text", "label": "Short description" }
    ] }
  ],
  "presets": [ { "name": "MT – Products", "blocks": [ { "type": "product" }, { "type": "product" } ] } ]
}
{% endschema %}
